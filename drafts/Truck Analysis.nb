Cell[CellGroupData[{

Cell["Modeling the Truck", "Chapter",
 CellChangeTimes->{{3.95370466861336*^9, 
  3.9537046711738863`*^9}},ExpressionUUID->"54f77282-d7cc-4c8a-af0e-\
9813b6bca685"],

Cell[CellGroupData[{

Cell["Rigid Body", "Section",
 CellChangeTimes->{{3.953704674588491*^9, 
  3.953704684812134*^9}},ExpressionUUID->"d2f81e4c-865a-480c-b27a-\
b75a1c0944de"],

Cell[TextData[{
 "We consider the truck as a rigid body and not consider the pressure of the \
tires that would cause the truck to jump in the incidence of hitting the bump \
fast. Let\[CloseCurlyQuote]s also assume the truck\[CloseCurlyQuote]s wheels \
always \[OpenCurlyDoubleQuote]hug\[CloseCurlyDoubleQuote] the road. We \
define:\n\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["x", "TI"], 
        StyleBox["r", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "x_r", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "125076a9-d8d9-4996-bbfb-d53ef3bdaf0b"],
 " as the ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["x", "TI"], TraditionalForm], "errors" -> {}, "input" -> "x", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "574a5756-0ac5-47b3-ad86-c1a1f2ef09f6"],
 "-coordinate where the rear axle contacts the road.\nWith a wheelbase ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["L", "TI"], TraditionalForm], "errors" -> {}, "input" -> "L", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3718f26d-9bec-4c71-90da-f796ade96407"],
 ", the front axle contacts at ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["x", "TI"], 
          StyleBox["r", "TI"]], "+", 
         StyleBox["L", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "x_r+L", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "51c465c4-b100-40b3-b0f1-1d33f412a607"],
 ". Thus contact points are:"
}], "Text",
 CellChangeTimes->{{3.9537046925255527`*^9, 
  3.95370487973033*^9}},ExpressionUUID->"b974f933-2c61-4e64-abc7-\
226efa086a8f"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"rearContactPoint", "=", 
  RowBox[{"{", 
   RowBox[{"xr", ",", " ", 
    RowBox[{"roadProfile", "[", "xr", "]"}]}], "}"}]}], "\[IndentingNewLine]", 
 RowBox[{"frontContactPoint", "=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"xr", "+", "wheelBase"}], ",", " ", 
    RowBox[{"roadProfile", "[", 
     RowBox[{"xr", "+", "wheelBase"}], "]"}]}], "}"}]}]}], "Input",
 CellChangeTimes->{{3.9537048884032297`*^9, 3.9537049260495787`*^9}, {
  3.9537049778576107`*^9, 3.953705056568802*^9}, {3.953706287016638*^9, 
