Cell[TextData[{
 "Consider two Carnot engines running in series, one between temperatures ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["T", "TI"], "1"], ",", 
         SubscriptBox[
          StyleBox["T", "TI"], "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "T_1, T_2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a6376498-7869-4743-a810-321b9f9ea99f"],
 " and the other between ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["T", "TI"], "2"], ",", 
         SubscriptBox[
          StyleBox["T", "TI"], "3"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "T_2, T_3", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "118defa7-d56d-4e6f-bf57-6c64d4a3f41c"],
 " (",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["T", "TI"], "1"], ">", 
         SubscriptBox[
          StyleBox["T", "TI"], "2"], ">", 
         StyleBox["T", "TI"], "3"}], TraditionalForm], "errors" -> {}, 
     "input" -> "T_1>T_2>T3", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3cfeb77a-d3d8-4370-9a5f-bd712ec14012"],
 "). Denote the heat exchanges and work outputs, of the two engines by ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["Q", "TI"], "1"], ",", 
         SubscriptBox[
          StyleBox["Q", "TI"], "2"], ",", 
         SubscriptBox[
          StyleBox["W", "TI"], "12"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "Q_1, Q_2,W_{12}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "06c6765b-f0da-4f1e-b9ff-812030d8730e"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["Q", "TI"], "2"], ",", 
         SubscriptBox[
          StyleBox["Q", "TI"], "3"], ",", 
         SubscriptBox[
          StyleBox["W", "TI"], "23"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "Q_2,Q_3, W_{23}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "15bcf3b9-dc34-4f23-b65f-6920d60234a0"],
 ", respectively. Note that the heat dumped by the first engine is taken in \
by the second, so the combined effect is another Carnot engine (since each \
component is reversible) with heat exchanges ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["Q", "TI"], "1"], ",", 
         SubscriptBox[
          StyleBox["Q", "TI"], "3"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "Q_1,Q_3", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "53920b4a-9424-4470-9294-be638928faf8"],
 " and work output ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["W", "TI"], "13"], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["W", "TI"], "12"], "+", 
         SubscriptBox[
          StyleBox["W", "TI"], "23"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "W_{13} = W_{12} + W_{23}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f44507d2-6345-4809-8296-24c039478afa"],
 "."
}], "Text",
 CellChangeTimes->{{3.974767166457073*^9, 3.974767241098806*^9}, {
  3.9747673132615623`*^9, 
  3.974767378313837*^9}},ExpressionUUID->"277b5994-259a-4340-91e8-\
d1c445bea8af"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Clear", "[", "\[Eta]", "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.974767395568759*^9, 3.974767401737568*^9}},
 CellLabel->"In[15]:=",ExpressionUUID->"198f007e-1b36-4a30-b986-637d485684dd"],

Cell["\<\
Using the universal efficiency, the three heat exchanges are related by:\
\>", "Text",
 CellChangeTimes->{{3.974767406613202*^9, 
  3.974767419001298*^9}},ExpressionUUID->"83b9053e-cf73-451c-ac5b-\
67b6731954f3"],

Cell[BoxData[
 RowBox[{"heatRelations", " ", "=", " ", 
  RowBox[{"{", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Q2", " ", "==", 
     RowBox[{"Q1", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"\[Eta]", "[", 
         RowBox[{"T1", ",", "T2"}], "]"}]}], ")"}]}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"Q3", " ", "==", " ", 
     RowBox[{"Q2", " ", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"\[Eta]", "[", 
         RowBox[{"T2", ",", "T3"}], "]"}]}], ")"}]}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"Q3", " ", "==", 
     RowBox[{"Q1", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"\[Eta]", "[", 
         RowBox[{"T1", ",", "T3"}], "]"}]}], ")"}]}]}]}], 
   "\[IndentingNewLine]", "}"}]}]], "Input",
 CellChangeTimes->{{3.9747674219307528`*^9, 3.974767518777829*^9}, {
  3.974767584909912*^9, 3.974767614866866*^9}},
 CellLabel->"In[21]:=",ExpressionUUID->"80d52dd0-a4dd-4873-ae89-296f0205ef7d"],

Cell["Comparison of the final two expressions yields:", "Text",
 CellChangeTimes->{{3.974767705881497*^9, 
  3.9747677141172333`*^9}},ExpressionUUID->"81997082-e487-48f6-9a39-\
95c7aee63f47"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"heatRelations", "[", 
     RowBox[{"[", "2", "]"}], "]"}], "[", 
    RowBox[{"[", "2", "]"}], "]"}], " ", "==", 
   RowBox[{
    RowBox[{"heatRelations", "[", 
     RowBox[{"[", "3", "]"}], "]"}], "[", 
    RowBox[{"[", "2", "]"}], "]"}]}], "/.", 
  RowBox[{"Q2", "->", 
   RowBox[{
    RowBox[{"heatRelations", "[", 
     RowBox[{"[", "1", "]"}], "]"}], "[", 
    RowBox[{"[", "2", "]"}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.9747677202056637`*^9, 3.9747678232486897`*^9}},
 CellLabel->"In[29]:=",ExpressionUUID->"b7da1dd2-ce8d-4e98-8065-c25b4e451f21"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Q1", " ", 
   RowBox[{"(", 
    RowBox[{"1", "-", 
     RowBox[{"\[Eta]", "[", 
      RowBox[{"T1", ",", "T2"}], "]"}]}], ")"}], " ", 
   RowBox[{"(", 
    RowBox[{"1", "-", 
     RowBox[{"\[Eta]", "[", 
      RowBox[{"T2", ",", "T3"}], "]"}]}], ")"}]}], "\[Equal]", 
  RowBox[{"Q1", " ", 
   RowBox[{"(", 
    RowBox[{"1", "-", 
     RowBox[{"\[Eta]", "[", 
      RowBox[{"T1", ",", "T3"}], "]"}]}], ")"}]}]}]], "Output",
 CellChangeTimes->{{3.97476775587186*^9, 3.974767762780923*^9}, {
  3.974767797097247*^9, 3.97476782431598*^9}},
 CellLabel->"Out[29]=",ExpressionUUID->"c1a4e537-9db2-45ad-b43f-9c930abbb3ff"]
}, Open  ]],

