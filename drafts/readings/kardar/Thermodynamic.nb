Cell[TextData[{
 "This and the two isothermal processes for ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["T", "TI"], 
        StyleBox["H", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "T_H", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "30790787-5730-4acd-a5bc-468b85dc2f79"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["T", "TI"], 
        StyleBox["C", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "T_C", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "be3bbbb8-3116-4b8c-b821-2d4817bbbb96"],
 ". We would get:"
}], "Text",
 CellChangeTimes->{{3.974764806282793*^9, 
  3.974764831667151*^9}},ExpressionUUID->"933aedec-070a-457a-94d8-\
8120f8d01221"],

Cell[BoxData[
 RowBox[{
  RowBox[{"IsoThermPressure", "[", 
   RowBox[{"V_", ",", "constant_"}], "]"}], ":=", 
  RowBox[{"(", 
   RowBox[{"constant", "/", "V"}], ")"}]}]], "Input",
 CellChangeTimes->{{3.974766606055377*^9, 3.974766606055429*^9}},
 CellLabel->"In[10]:=",ExpressionUUID->"fc0936c3-5cf9-4075-aa0a-6c52c826b701"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"P", "[", 
      RowBox[{"V", ",", 
       RowBox[{"5", "/", "3"}], ",", "1"}], "]"}], ",", 
     RowBox[{"P", "[", 
