% ============================================================================
% TITLE AND AUTHOR COMMANDS
% ============================================================================

% Author information
\newcommand{\setauthor}[1]{\def\@author{#1}}
\newcommand{\authorheader}{\@author}
\newcommand{\setauthorshort}[1]{\def\@authorshort{#1}}
\newcommand{\authorshort}{\@authorshort}
\newcommand{\setaffiliation}[1]{\def\@affiliation{#1}}
\newcommand{\affiliation}{\@affiliation}
\newcommand{\setemail}[1]{\def\@email{#1}}
\newcommand{\authoremail}{\@email}

% Title information
\newcommand{\settitle}[1]{\def\@title{#1}}
\newcommand{\titleheader}{\@title}
\newcommand{\settitleshort}[1]{\def\@titleshort{#1}}
\newcommand{\titleshort}{\@titleshort}
\newcommand{\setsubtitle}[1]{\def\@subtitle{#1}}
\newcommand{\subtitle}{\@subtitle}

% Date information
\newcommand{\setdate}[1]{\def\@date{#1}}
\newcommand{\dateheader}{\@date}
\newcommand{\setversion}[1]{\def\@version{#1}}
\newcommand{\version}{\@version}

% Additional metadata
\newcommand{\setkeywords}[1]{\def\@keywords{#1}}
\newcommand{\keywords}{\@keywords}
\newcommand{\setsubject}[1]{\def\@subject{#1}}
\newcommand{\subject}{\@subject}
\newcommand{\setdoctype}[1]{\def\@doctype{#1}}
\newcommand{\doctype}{\@doctype}
\newcommand{\setcourse}[1]{\def\@course{#1}}
\newcommand{\course}{\@course}
\newcommand{\setinstitution}[1]{\def\@institution{#1}}
\newcommand{\institution}{\@institution}


% ============================================================================
% HEADERS & FOOTERS
% ============================================================================

\pagestyle{fancy}
\fancyhf{}  % Clear default settings

% Customize based on document type (can be overridden in templates)
\fancyhead[L]{\sffamily\small\textcolor{DarkGray}{\leftmark}}
\fancyhead[R]{\sffamily\small\textcolor{DarkGray}{\authorheader}}
\fancyfoot[C]{\sffamily\small\textcolor{MediumGray}{\thepage}}

% Remove header rule (clean minimal look)
\renewcommand{\headrulewidth}{0pt}

% ============================================================================
% HYPERLINKS
% ============================================================================

\hypersetup{
    colorlinks   = true,
    linkcolor    = LinkColor,
    urlcolor     = LinkColor,
    citecolor    = LinkColor,
    pdfborder    = {0 0 0},
}

% ============================================================================
% CODE ENVIRONMENTS
% ============================================================================

\RequirePackage{listings}

\lstset{
    basicstyle       = \ttfamily\small\color{CodeText},
    backgroundcolor  = \color{CodeBackground},
    frame            = single,
    rulecolor        = \color{CodeBorder},
    breaklines       = true,
    showstringspaces = false,
    columns          = flexible,
    numbers          = left,
    numberstyle      = \tiny\color{MediumGray},
    xleftmargin      = 2em,
    framexleftmargin = 1.5em,
}

% ============================================================================
% FIGURE & TABLE CAPTIONS
% ============================================================================

\RequirePackage{caption}

\captionsetup{
    font           = {small,sf},
    labelfont      = {bf,color=CaptionColor},
    textfont       = {color=CaptionColor},
    justification  = centering,
}

% ============================================================================
% UTILITY MACROS
% ============================================================================

% Horizontal rule with brand color
\newcommand{\kidarule}{\textcolor{RuleColor}{\rule{\linewidth}{0.5pt}}}

% Brand signature
\newcommand{\kidabrand}{%
    {\sffamily\color{KidA}\textbf{Kid-A-Print}}%
}



\endinput
