	"nodes":[
		{"id":"357bc47955cdd76e","text":"# Editor Configuration\nStates the types of content we have in the document, how to render them and more configurations for the editor (for example plugins, wrappers, themes, etc)","type":"text","x":-680,"y":-400,"width":1000,"height":160,"color":"3"},
		{"id":"74817f657b79818b","text":"# Block Registry\n\nSets up types, and rendering functions for blocks.","type":"text","x":-680,"y":-680,"width":320,"height":140,"color":"5"},
		{"id":"57f48328e07134fb","text":"# Plugin Registry\n\nSets up plugins that are being used in the editor.","type":"text","x":-340,"y":-680,"width":320,"height":140,"color":"6"},
		{"id":"0d5acc12eace4c79","text":"# Theme Registry\n\nSets up themes and styling to be used in the editor","type":"text","x":0,"y":-680,"width":320,"height":140,"color":"4"},
		{"id":"9a1ba3d545e2e544","text":"# Editor\nManages the document (parsing HTML/CSS, LaTeX or anything else via renders and configured maps)","type":"text","x":-680,"y":-120,"width":1000,"height":120,"color":"2"},
		{"id":"879fbbb624d42f42","text":"# Document","type":"text","x":-680,"y":180,"width":1000,"height":50,"color":"#ffffff"},
		{"id":"47b7b1cd59202f1d","text":"# Block\nUnit of Content for the editor. Can be image, text, code, runnable script or anything the developer wants.","type":"text","x":-680,"y":-1020,"width":320,"height":200,"color":"#7caefe"},
		{"id":"9c4fdfb41a4a0f0a","text":"# Block Type","type":"text","x":-680,"y":-1120,"width":320,"height":60,"color":"#7caefe"},
		{"id":"4c5b1fa55f1a348e","text":"# Render Function\nFor specific type of block `<block-type>` would produce rendered form of the content.","type":"text","x":-320,"y":-1020,"width":320,"height":200,"color":"#7caefe"},
		{"id":"de12f71d77d0ab18","text":"# Plugin\nFor a specific type of block, wrapper, or editor manipulates code, add, or remove things.","type":"text","x":-320,"y":-1320,"width":320,"height":200,"color":"#7caefe"},
		{"id":"b3b4333742472c34","text":"# User","type":"text","x":640,"y":-120,"width":250,"height":350}
	]
}