Cell[TextData[{
 "Putting them together:\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["f", "TI"], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], "\[LongEqual]", 
         StyleBox["x", "TI"], "arctan", 
         RowBox[{"(", "\[Theta]", ")"}], "+", 
         StyleBox["b", "TI"], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}]}], TraditionalForm], "errors" -> {}, 
     "input" -> "f(x) = x\\arctan(\\theta) + b(x)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7bec56e5-aaa8-42c2-b2d0-d275d2f30702"]
}], "Text",
 CellChangeTimes->{{3.953704490859641*^9, 
  3.953704502995701*^9}},ExpressionUUID->"22804def-b67b-4aaa-9cdc-\
a6ad5789d2e4"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"roadProfile", "[", "x_", "]"}], ":=", 
   RowBox[{
    RowBox[{"slopeProfile", "[", "x", "]"}], "+", 
    RowBox[{"bumpProfile", "[", "x", "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"roadProfile", "[", "x", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "2"}], ",", "2"}], "}"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.9537045298571672`*^9, 3.953704557983564*^9}, {
  3.953704935417252*^9, 3.95370496988291*^9}},
 CellLabel->
  "In[259]:=",ExpressionUUID->"0522f6cb-5947-4cd1-9205-5afd8106ce8f"],

