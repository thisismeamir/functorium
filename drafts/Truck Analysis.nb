Cell[TextData[{
 "When the chassis rotates by ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Alpha]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\alpha", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ac1ba958-fb00-4c77-871d-8f0af5a9d3f4"],
 ", the vertical offset of the roof above this midpoint is ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["d", "TI"], "cos", "\[Alpha]"}], TraditionalForm], 
     "errors" -> {}, "input" -> "d\\cos\\alpha", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8540ae95-ac81-4c70-972e-3b3420495d98"],
 ". Thus, the roof\[CloseCurlyQuote]s vertical coordinate relative to the \
ground is approximately:"
}], "Text",
 CellChangeTimes->{{3.9537053548572483`*^9, 
  3.953705442971035*^9}},ExpressionUUID->"dcee17fc-61e7-49ed-be63-\
94efc8390a68"],

Cell[BoxData[
 RowBox[{
  RowBox[{"roofHeightCoordinate", "[", "xr_", "]"}], ":=", 
  RowBox[{
   FractionBox[
    RowBox[{
     RowBox[{"roadProfile", "[", "xr", "]"}], "+", 
     RowBox[{"roadProfile", "[", 
      RowBox[{"xr", "+", "wheelBase"}], "]"}]}], "2"], "+", " ", 
   RowBox[{"truckHeight", " ", 
    RowBox[{"Cos", "[", 
     RowBox[{"ArcTan", "[", 
      FractionBox[
       RowBox[{
        RowBox[{"roadProfile", "[", 
         RowBox[{"xr", "+", "wheelBase"}], "]"}], "-", 
        RowBox[{"roadProfile", "[", "xr", "]"}]}], "wheelBase"], "]"}], 
     "]"}]}]}]}]], "Input",
 CellChangeTimes->{{3.953707345264636*^9, 3.953707419928842*^9}},
 CellLabel->
  "In[300]:=",ExpressionUUID->"7855a2cb-3a8e-4ef3-9908-847c91fcd43b"],

Cell["\<\
This formula gives you the roof height as a function of the truck' s position \
relative to the bump.\
\>", "Text",
 CellChangeTimes->{{3.9537055648831167`*^9, 
  3.953705574881027*^9}},ExpressionUUID->"45e3ac8f-4391-48f4-9503-\
4b78e54d8923"]
}, Open  ]],

