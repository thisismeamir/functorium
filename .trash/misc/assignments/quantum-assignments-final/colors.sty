\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{colors}[2025/11/02 v1.0 A-Print Color System]

% Required package for color support
\RequirePackage{xcolor}

% ============================================================================
	% PRIMARY BRAND COLOR
% ============================================================================
\definecolor{KidA}{HTML}{7017FF}           % Primary accent color

% ============================================================================
% GRAYSCALE PALETTE
% ============================================================================
\definecolor{TextBlack}{HTML}{101010}      % Primary text
\definecolor{DarkGray}{HTML}{404040}       % Secondary text
\definecolor{MediumGray}{HTML}{808080}     % Tertiary text
\definecolor{LightGray}{HTML}{CCCCCC}      % Borders, rules
\definecolor{AccentGray}{HTML}{D9D9D9}     % Backgrounds, subtle accents
\definecolor{OffWhite}{HTML}{F8F8F8}       % Code blocks, boxes
\definecolor{Black}{HTML}{000000}
\definecolor{White}{HTML}{FFFFFF}
% ============================================================================
% SEMANTIC COLORS
% ============================================================================
% These colors have specific functional meanings in documents

\colorlet{NeutralText}{TextBlack}


\colorlet{HeadingColor}{KidA}              % Section headings
\colorlet{LinkColor}{MediumGray}                 % Hyperlinks
\colorlet{EmphasisColor}{Black}             % Important callouts

\colorlet{CodeBackground}{OffWhite}        % Code block backgrounds
\colorlet{CodeBorder}{LightGray}           % Code block borders
\colorlet{CodeText}{DarkGray}              % Inline code text

\colorlet{RuleColor}{LightGray}            % Horizontal rules
\colorlet{CaptionColor}{DarkGray}          % Figure/table captions

% ============================================================================
% UTILITY COMMANDS
% ============================================================================

% Colorize text with primary brand color
\newcommand{\brandColor}[1]{\textcolor{KidA}{#1}}

% Colorize text with semantic meaning
\newcommand{\emphtext}[1]{\textcolor{EmphasisColor}{\textbf{#1}}}

\endinput
