     RowBox[{"\"\<Volume\>\"", ",", "\"\<Pressure\>\""}], "}"}]}], ",", 
   RowBox[{"PlotLabel", "->", "\"\<Carnot Cycle\>\""}]}], "]"}]], "Input",
