Cell[TextData[{
 "The adiabatic curves are clearly distinct from the isotherms, and we can \
select two such curves to intersect our isotherms, thereby completing a \
Carnot cycle . The assumption of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["E", "TI"], "\[Proportional]", 
         StyleBox["T", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "E\\propto T", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "713ad5de-53ec-49f4-9bfa-ff967f386f47"],
 " is not necessary. In fact, a similar construction is possible for any two \
- parameter system with ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["E", "TI"], "(", 
         RowBox[{
           StyleBox["J", "TI"], ",", 
           StyleBox["x", "TI"]}], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "E(J,x)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0b507c9d-601c-4285-8e8a-0bdb0cee9b6b"],
 ".\n    \n",
 StyleBox["Carnot' s theorem",
  FontWeight->"Bold"],
 " No engine operating between two reservoirs (at temperatures TH and TC) is \
more efficient than a Carnot engine operating between them.\n\nSince a Carnot \
engine is reversible, it can be run backward as a refrigerator."
}], "Text",
 CellChangeTimes->{{3.9747666552817097`*^9, 
  3.974766778611486*^9}},ExpressionUUID->"8787c165-0fa0-4fc8-aff9-\
5974f05012be"],

Cell[TextData[{
 "Let us denote the heat exchanges of the non - Carnot and Carnot engines by ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["Q", "TI"], 
        StyleBox["H", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "Q_H", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d910b180-3709-4351-9ded-0f2cf7ee4030"],
 ", ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["Q", "TI"], 
        StyleBox["C", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "Q_C", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c805bc4d-57b9-498b-bac8-6167006c42ed"],
 ", and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox[
          StyleBox["Q", "TI"], 
          StyleBox["H", "TI"], "\[Prime]"], ",", 
         SubsuperscriptBox[
          StyleBox["Q", "TI"], 
          StyleBox["C", "TI"], "\[Prime]"]}], TraditionalForm], 
     "errors" -> {}, "input" -> "Q_H', Q_C'", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b76f547e-1052-4593-a24c-2a738e076fb6"],
 ", respectively . The net effect of the two engines is to transfer heat \
equal to ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["Q", "TI"], 
          StyleBox["H", "TI"]], "-", 
         SubsuperscriptBox[
          StyleBox["Q", "TI"], 
          StyleBox["H", "TI"], "\[Prime]"], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["Q", "TI"], 
          StyleBox["C", "TI"]], "-", 
         SubsuperscriptBox[
          StyleBox["Q", "TI"], 
          StyleBox["C", "TI"], "\[Prime]"]}], TraditionalForm], 
     "errors" -> {}, "input" -> "Q_H - Q_H' = Q_C-Q_C'", "state" -> "Boxes"|>,
    
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "10f8cdd2-315d-4821-b4e8-3389e08dfb4b"],
 " C from ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["T", "TI"], 
        StyleBox["H", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "T_H", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6a5de019-741d-42ec-8061-2f6064171b2e"],
 " to ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["T", "TI"], 
        StyleBox["C", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "T_C", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e671961a-ff64-408e-a81f-3cc140baea11"],
 " .\n\nAccording to Clausius' s statement, the quantity of transferred heat \
cannot be negative, that is,"
}], "Text",
 CellChangeTimes->{{3.974766801221964*^9, 
  3.974766872589534*^9}},ExpressionUUID->"7afa975a-6254-44bf-9537-\
396cbde6e380"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"QH", " ", ">=", " ", 
  SubscriptBox["QC", "carnot"]}]], "Input",
 CellChangeTimes->{{3.974766873654668*^9, 3.974766883745462*^9}},
 CellLabel->"In[12]:=",ExpressionUUID->"6e119e71-2f3c-4754-8902-5b32a994807b"],

Cell[BoxData[
 RowBox[{"QH", "\[GreaterEqual]", 
  SubscriptBox["QC", "carnot"]}]], "Output",
 CellChangeTimes->{3.974766884227426*^9},
 CellLabel->"Out[12]=",ExpressionUUID->"df841ebd-5f7c-405d-93cb-34231d23f397"]
}, Open  ]],

Cell[TextData[{
 "Since the same quantity of work ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["W", "TI"], TraditionalForm], "errors" -> {}, "input" -> "W", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "01b77f96-cde4-4a4a-9589-e1c73fe02e85"],
 " is involved in this process, we conclude that:"
}], "Text",
 CellChangeTimes->{{3.974766886721167*^9, 
  3.9747668961670933`*^9}},ExpressionUUID->"4d985437-8406-4b4e-9ae9-\
87fef4bed932"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[Eta]", "[", 
    RowBox[{"W_", ",", "Q_"}], "]"}], ":=", 
   FractionBox["W", "Q"]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Eta]", "[", 
   RowBox[{"W", ",", 
    SubscriptBox["Q", "nonCarnot"]}], "]"}], "<=", " ", 
  RowBox[{"\[Eta]", "[", 
   RowBox[{"W", ",", 
    SubscriptBox["Q", "Carnot"]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.974766897514859*^9, 3.974766929349409*^9}},
 CellLabel->"In[13]:=",ExpressionUUID->"98f612c3-324c-495e-b517-302752aff600"],

Cell[BoxData[
 RowBox[{
  FractionBox["W", 
   SubscriptBox["Q", "nonCarnot"]], "\[LessEqual]", 
  FractionBox["W", 
   SubscriptBox["Q", "Carnot"]]}]], "Output",
 CellChangeTimes->{3.974766929912225*^9},
 CellLabel->"Out[14]=",ExpressionUUID->"16094650-f9dc-4098-9519-039a6fd9b127"]
}, Open  ]],

Cell[TextData[{
 StyleBox["Corollary",
  FontWeight->"Bold"],
 " All reversible (Carnot) engines have the same universal efficiency ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Eta]", "(", 
         RowBox[{
           SubscriptBox[
            StyleBox["T", "TI"], 
            StyleBox["H", "TI"]], ",", 
           SubscriptBox[
            StyleBox["T", "TI"], 
            StyleBox["C", "TI"]]}], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\eta(T_H,T_C)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d408de2d-d2d0-4dda-b917-576771154519"],
 ", since each can be used to run any other one backward .\n\nThe \
thermodynamic temperature scale : as shown earlier, it is at least \
theoretically possible to construct a Carnot engine using an ideal gas (or \
any other two - parameter system) as working substance .\n\nIndependent of \
the material used, and design and construction, all such cyclic and \
reversible engines have the same maximum theoretical efficiency.\n\nSince \
this maximum efficiency is only dependent on two temperatures, it can be used \
to construct a temperature scale. Such a temperature scale has the attractive \
property of being independent of the properties of any material (e.g., the \
ideal gas)."
}], "Text",
 CellChangeTimes->{{3.9747669454601803`*^9, 
  3.974767106449637*^9}},ExpressionUUID->"2b02fc60-f9c2-4d51-bed0-\
b5c29a9e9732"],

