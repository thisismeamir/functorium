Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", 
    RowBox[{"1", "-", 
     RowBox[{"\[Eta]", "[", 
      RowBox[{"T1", ",", "T2"}], "]"}]}], ")"}], " ", 
   RowBox[{"(", 
    RowBox[{"1", "-", 
     RowBox[{"\[Eta]", "[", 
      RowBox[{"T2", ",", "T3"}], "]"}]}], ")"}]}], "\[Equal]", 
  RowBox[{"1", "-", 
   RowBox[{"\[Eta]", "[", 
    RowBox[{"T1", ",", "T3"}], "]"}]}]}]], "Output",
 CellChangeTimes->{3.974767832059504*^9},
 CellLabel->"Out[30]=",ExpressionUUID->"49e68ba6-93dd-45ee-8164-220e9c131417"]
}, Open  ]],

Cell[TextData[{
 "This property implies that ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"1", "-", "\[Eta]", 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox[
              StyleBox["T", "TI"], "1"], ",", 
             SubscriptBox[
              StyleBox["T", "TI"], "2"]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "1-\\eta(T_1,T_2)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4339209a-9e6f-47cf-b8be-7a0b9747cc81"],
 " can be written as a ration of the form ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["f", "TI"], 
         RowBox[{"(", 
           SubscriptBox[
            StyleBox["T", "TI"], "2"], ")"}], "/", 
         StyleBox["f", "TI"], 
         RowBox[{"(", 
           SubscriptBox[
            StyleBox["T", "TI"], "1"], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "f(T_2)/f(T_1)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "366925be-f72a-49ed-b601-6963deb3fef5"],
 ", which by convention is set to ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["T", "TI"], "2"], "/", 
         SubscriptBox[
          StyleBox["T", "TI"], "1"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "T_2/T_1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "09623965-3080-481d-b2d0-43933eb2a132"],
 ", that is,"
}], "Text",
 CellChangeTimes->{{3.974767840287099*^9, 
  3.974767878186789*^9}},ExpressionUUID->"a061d3cd-6904-48d3-9050-\
351428e73d0a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Eta]", "[", 
   RowBox[{"T1_", ",", "T2_"}], "]"}], ":=", 
  RowBox[{"1", "-", 
   FractionBox["T2", "T1"]}]}]], "Input",
 CellChangeTimes->{{3.97476788142869*^9, 3.974767929379484*^9}},
 CellLabel->"In[31]:=",ExpressionUUID->"c9c053cf-608f-4251-b64d-2be5b27e4b12"],

Cell[TextData[{
 "This equation defines temperature up to a constant of proportionality, \
which is again set by choosing the triple point of water, ice, and steam. So \
far we\[CloseCurlyQuote]ve been using ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[CapitalTheta]", TraditionalForm], "errors" -> {}, 
     "input" -> "\\Theta", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ab301740-aff1-4965-a22f-67bbb1b7fef8"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["T", "TI"], TraditionalForm], "errors" -> {}, "input" -> "T", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b49b55b5-613a-477d-8684-fce7264993c3"],
 " interchangeably. In fact, by running a Carnot cycle for a perfect gas, it \
can be proved that the ideal gas and thermodynamic temperature scales are \
equivalent.\n\nAll thermodynamic temperatures are positive, since according \
to equation of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Eta]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\eta", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ec39d8f3-dc5f-4535-a773-7033d0cefba7"],
 ", the heat extracted from a temperature ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["T", "TI"], TraditionalForm], "errors" -> {}, "input" -> "T", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9d4cfb16-ed91-4941-8631-4ad08290c831"],
 " is proportional to it. If a negative temperature existed, an engine \
operating between it and a positive temperature would extract heat from both \
reservoirs and convert the sum total to work, in violation of Kelvin\
\[CloseCurlyQuote]s statement of the second law."
}], "Text",
 CellChangeTimes->{{3.974767947285288*^9, 
  3.9747681422526693`*^9}},ExpressionUUID->"f4edb26f-4eec-441f-b96d-\
9956718bae56"]
}, Open  ]],

Cell["1.6 Entropy", "Chapter",
 CellChangeTimes->{{3.974768156679716*^9, 
  3.974768163125547*^9}},ExpressionUUID->"9c0603cd-3b87-4a87-b61c-\
7db43a313eb0"]
}, Open  ]]
},
