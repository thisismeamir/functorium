\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{kida}[2025/11/02 v1.0 Kid-A-Print Base Style]

% ============================================================================
% LOAD DEPENDENCIES
% ============================================================================

\RequirePackage{colors}     % Color system
\RequirePackage[
    serif
]{fonts}      % Typography

% Core layout packages
\RequirePackage[margin=2cm,a4paper]{geometry}
\RequirePackage{parskip}        % Space between paragraphs
\RequirePackage{titlesec}       % Section formatting
\RequirePackage{fancyhdr}       % Headers and footers
\RequirePackage{hyperref}       % Links and metadata

% ============================================================================
% PAGE LAYOUT
% ============================================================================

% Paragraph spacing
\setlength{\parskip}{\baselineskip}
\setlength{\parindent}{0pt}

% Line spacing
\linespread{1.1}
