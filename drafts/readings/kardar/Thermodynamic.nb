     RowBox[{"\"\<Adiabatic 1\>\"", ",", "\"\<Adiabatic 2\>\"", 
      ",", "\"\<Isothermal Hot\>\"", ",", "\"\<Isothermal Cold\>\""}], 
     "}"}]}], ",", 
   RowBox[{"AxesLabel", "->", 
