   RowBox[{"1.9125`", "\[VeryThinSpace]", "+", "xr"}], ",", 
   RowBox[{
    FractionBox["1", "2"], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"xr", " ", 
       RowBox[{"ArcTan", "[", 
        FractionBox["\[Pi]", "4"], "]"}]}], "+", 
