Cell[TextData[{
 "Now the slope can be modeled easily by:\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["x", "TI"], "arctan", 
         RowBox[{"(", "\[Theta]", ")"}]}], TraditionalForm], "errors" -> {}, 
     "input" -> "x\\arctan(\\theta)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d40ac971-fb2a-4b2a-9811-e197de669a88"],
 ". "
}], "Text",
 CellChangeTimes->{{3.953704383541464*^9, 
  3.9537044100018597`*^9}},ExpressionUUID->"bd46a3c1-df44-446b-ae3f-\
9e4f90537059"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"slopeAngle", " ", "=", " ", 
   FractionBox["Pi", "4"]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"slopeProfile", "[", "x_", "]"}], ":=", 
   RowBox[{"x", " ", 
    RowBox[{"ArcTan", "[", "slopeAngle", "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"slopeProfile", "[", "x", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "2"}], ",", "2"}], "}"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.953704411987282*^9, 3.953704486272956*^9}, {
  3.9537045976800137`*^9, 3.9537045982227697`*^9}},
 CellLabel->
  "In[256]:=",ExpressionUUID->"8b79a89d-0b68-465b-b655-1390072d1bf7"],

